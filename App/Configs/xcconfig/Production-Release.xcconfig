#include "Production.xcconfig"
#include "Pods/Target Support Files/Pods-XAuth/Pods-XAuth.production release.xcconfig"

APP_DISPLAY_NAME = Auth_PR
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon_KAuthPR

// 
// PENGATURAN KHUSUS RELEASE ("ENCRYPT")
// 
// Optimasi untuk kecepatan (ini yang Anda maksud "encrypt")
SWIFT_OPTIMIZATION_LEVEL = -O

// Flags: Hanya PRODUCTION
OTHER_SWIFT_FLAGS = $(inherited) -DPRODUCTION

// Optimasi level tinggi, mengompilasi semua file Swift bersamaan
SWIFT_COMPILATION_MODE = wholemodule