#include "Staging.xcconfig"
#include "Pods/Target Support Files/Pods-XAuth/Pods-XAuth.staging release.xcconfig"

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon_KAuthSR
INFOPLIST_KEY_CFBundleDisplayName = XAuth_App_SR

SWIFT_OPTIMIZATION_LEVEL = -Onone

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) STAGING STAGING_RELEASE
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) STAGING=1 STAGING_RELEASE=1