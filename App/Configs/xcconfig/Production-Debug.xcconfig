#include "Production.xcconfig"
#include "Pods/Target Support Files/Pods-XAuth/Pods-XAuth.production debug.xcconfig"

APP_DISPLAY_NAME = Auth_PD
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon_KAuthPD
INFOPLIST_KEY_CFBundleDisplayName = XAuth_PD

// 
// PENGATURAN KHUSUS DEBUG
// 
// Tidak ada optimasi (agar gampang di-debug)
SWIFT_OPTIMIZATION_LEVEL = -Onone

// Menambahkan flag "DEBUG" yang bisa Anda cek di kode Swift (mis: #if DEBUG)
OTHER_SWIFT_FLAGS = $(inherited) -DDEBUG -DPRODUCTION

// Menambahkan flag "DEBUG" untuk Objective-C
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1 PRODUCTION=1