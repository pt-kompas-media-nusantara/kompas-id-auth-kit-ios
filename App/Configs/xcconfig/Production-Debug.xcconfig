#include "Production.xcconfig"
#include "Pods/Target Support Files/Pods-XAuth/Pods-XAuth.production debug.xcconfig"

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon_KAuthPD
INFOPLIST_KEY_CFBundleDisplayName = XAuth_App_PD

SWIFT_OPTIMIZATION_LEVEL = -Onone

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG PRODUCTION PRODUCTION_DEBUG
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1 PRODUCTION=1 PRODUCTION_DEBUG=1