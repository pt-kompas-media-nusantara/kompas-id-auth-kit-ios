require 'dotenv'
require 'base64'

# Gunakan fallback path relatif terhadap Dir.pwd karena __FILE__ tidak reliabel saat di-eval oleh Fastlane
dotenv_path = File.exist?(".env") ? ".env" : File.join(Dir.pwd, "fastlane", ".env")
Dotenv.load(dotenv_path) if File.exist?(dotenv_path)

secret_path = File.exist?(".env.secret") ? ".env.secret" : File.join(Dir.pwd, "fastlane", ".env.secret")
Dotenv.overload(secret_path) if File.exist?(secret_path)


git_url("https://github.com/pt-kompas-media-nusantara/kompas-id-auth-kit-ios-certificated")
storage_mode("git")
type("appstore") # The default type, can be: appstore, adhoc, enterprise or development, atau distribution
app_identifier(["id.kompas.app.auth"])
username("nurirppan@gmail.com") # Your Apple Developer Portal username

if ENV["GIT_AUTHORIZATION"]
  git_basic_authorization(Base64.strict_encode64(ENV["GIT_AUTHORIZATION"]))
end

